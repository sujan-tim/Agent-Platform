{
  // Press F5 (Run and Debug) to start the server with breakpoints working.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run server",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/src/server.ts",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Run server (mock brain, no Ollama)",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/src/server.ts",
      "cwd": "${workspaceFolder}",
      "env": { "AI_PROVIDER": "mock" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Run tests",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--import", "tsx", "--test", "--test-reporter=spec"],
      "args": ["test/agent.test.ts", "test/server.test.ts", "test/store.test.ts"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
