# Copy this file to .env and fill in what you need. .env is never committed.

# Which AI brain to use: ollama (free, local), mock (no model, for testing) or anthropic (Claude).
AI_PROVIDER=ollama

# Ollama: where it runs and which model to use. The model must support tools
# (llama3.1, qwen2.5, mistral-nemo). Download it first: ollama pull llama3.1
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Search by meaning: ollama or off. Defaults to ollama when AI_PROVIDER=ollama,
# otherwise off (keyword search). With Claude you can still set this to ollama.
# Download the model first: ollama pull nomic-embed-text
# EMBEDDINGS=ollama
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Claude, for AI_PROVIDER=anthropic. Create a key at console.anthropic.com
# and set a spending limit there. Never commit a real key.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Live web search, so the agent can answer about current events. Free key
# (1,000 searches a month, no card) at https://tavily.com. Leave unset to
# keep the agent offline.
# TAVILY_API_KEY=

# The company database: a Google Sheet the agent reads and (after approval) updates.
# GOOGLE_SERVICE_ACCOUNT_JSON is the robot account's whole key file; SHEET_ID is
# the sheets this server may connect (comma-separated). Share each sheet with
# the robot's email as Editor, then connect it under Admin → Company database.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# SHEET_ID=

# Server
PORT=3000
# Where the data lives. Leave unset on a laptop: it is kept in data/pglite
# (Postgres running inside Node; nothing to install). Hosted, set it to a
# Postgres connection string, such as the one Neon gives you.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# A long random string that signs sign-in cookies. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=
# Set to false to stop new companies signing up (for example on a demo server).
# Set to true to let anyone create a new company from the sign-in page. Off by
# default: people join when an admin adds them or approves their access request.
# ALLOW_SIGNUP=false
